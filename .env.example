# ==============================================================================
# ENVIRONMENT VARIABLES - KIDS DIGITAL STORE
# ==============================================================================

# Public URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret Key for HMAC-SHA256 Download Link Signatures
DOWNLOAD_TOKEN_SECRET=replace_with_high_entropy_secret_key_minimum_32_characters

# Supabase (PostgreSQL & Private File Storage for PDFs)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 1. Stripe (Credit/Debit Card Hosted Checkout - PCI-DSS Level 1)
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51xxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx

# 2. PayPal (Hosted Window & PayPal JavaScript SDK)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_MODE=sandbox # sandbox or live

# 3. Cryptocurrency Gateway (Coinbase Commerce / NOWPayments)
COINBASE_COMMERCE_API_KEY=your_coinbase_commerce_api_key
COINBASE_COMMERCE_WEBHOOK_SECRET=your_coinbase_webhook_shared_secret

# Resend (Automated Transactional Emails for Download Delivery)
RESEND_API_KEY=re_xxxxxxxxx
FROM_EMAIL=downloads@yourkidsstore.com

# Admin Security Token
ADMIN_SECRET_KEY=super-secret-admin-passphrase
